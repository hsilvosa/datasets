            <cac:PartyIdentification><cbc:ID schemeName="ID_PLATAFORMA">42</cbc:ID></cac:PartyIdentification>
            <cac:PartyName><cbc:Name>Sample contracting authority</cbc:Name></cac:PartyName>
          </cac:Party>
        </cac-place-ext:LocatedContractingParty>
        <cac:ProcurementProject>
          <cbc:Name>Supply of research equipment</cbc:Name>
          <cbc:TypeCode>1</cbc:TypeCode>
