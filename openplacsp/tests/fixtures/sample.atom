            <cbc:Name>Microscopes</cbc:Name>
            <cac:BudgetAmount><cbc:TaxExclusiveAmount currencyID="EUR">60000</cbc:TaxExclusiveAmount></cac:BudgetAmount>
            <cac:RequiredCommodityClassification>
              <cbc:ItemClassificationCode name="Microscopes">38510000</cbc:ItemClassificationCode>
            </cac:RequiredCommodityClassification>
          </cac:ProcurementProject>
        </cac:ProcurementProjectLot>
