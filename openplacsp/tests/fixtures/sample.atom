    <content>
      <cac-place-ext:ContractFolderStatus>
        <cbc:ContractFolderID>EXP-1</cbc:ContractFolderID>
        <cbc-place-ext:ContractFolderStatusCode>PUB</cbc-place-ext:ContractFolderStatusCode>
        <cac-place-ext:LocatedContractingParty>
